# Copy thành .env khi chạy local (không commit file .env)
DATABASE_URL=postgresql://talent:talent@localhost:5432/talentcompass
JWT_SECRET=doi-chuoi-bi-mat-dai-ngau-nhien
FRONTEND_URL=http://localhost:3000

# Nhà cung cấp AI: auto (có key nào dùng key đó), anthropic hoặc gemini.
# Không có key nào -> chế độ dữ liệu mẫu (không tốn tiền API)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_FAST_MODEL=claude-haiku-5-5
LLM_SMART_MODEL=claude-sonnet-5-5

# Lấy key tại https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_SMART_MODEL=gemini-2.5-pro
